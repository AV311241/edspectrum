NODE_ENV=development
PORT=5000
CORS_ORIGIN=*
LOG_LEVEL=info
ENABLE_LOGGING=true
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=24h
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=edspectrum
DATABASE_URL="mysql://root:root@localhost:3306/edspectrum"
# --- Default administrator seeded on first backend boot (see src/seed/admin.seed.ts) ---
# First spin: if no user with this email (and no other ADMIN-role user) exists, it is created.
# Later spins: seed detects the existing admin and skips creation.
# ALWAYS override DEFAULT_ADMIN_PASSWORD in production.
DEFAULT_ADMIN_EMAIL=admin@edspectrum.org
DEFAULT_ADMIN_PASSWORD=ChangeMe#Admin1
DEFAULT_ADMIN_FIRST_NAME=Platform
DEFAULT_ADMIN_LAST_NAME=Administrator
